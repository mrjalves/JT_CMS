<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>JT_CMS.Web.UI</PackageId>
    <Version>0.0.1</Version>
    <Authors>Amir Pournasserian</Authors>
    <Company>JT_CMS</Company>
    <Description>Web UI.</Description>
    <PackageTags>JT_CMS;cms;ui;sitebuilder;plugin;core</PackageTags>
    <RepositoryUrl>https://github.com/JT_CMS/JT_CMS</RepositoryUrl>
    <PackageProjectUrl>https://JT_CMS.com</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Providers\TemplateRenderingProviders\JT_CMS.Providers.TemplateRenderingProviders.Abstractions\JT_CMS.Providers.TemplateRenderingProviders.Abstractions.csproj" />
    <ProjectReference Include="..\..\Providers\MessageBusProviders\JT_CMS.Providers.MessageBusProviders.Abstractions\JT_CMS.Providers.MessageBusProviders.Abstractions.csproj" />
    <ProjectReference Include="..\JT_CMS.Web.ApiClients\JT_CMS.Web.ApiClients.csproj" />
    <ProjectReference Include="..\Plugins\JT_CMS.Web.Plugins.Base\JT_CMS.Web.Plugins.Base.csproj" />
    <ProjectReference Include="..\JT_CMS.Web.UI.Components\JT_CMS.Web.UI.Components.csproj" />
    <ProjectReference Include="..\JT_CMS.Web.UI.TailwindStyleBuilder\JT_CMS.Web.UI.TailwindStyleBuilder.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\icon.png" Pack="true" PackagePath="icon.png" />
    <None Include="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
