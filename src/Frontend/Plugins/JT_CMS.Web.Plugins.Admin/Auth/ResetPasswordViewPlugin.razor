@inherits BasePlugin

<PluginForm Model="@Model" Name="@FORM_NAME" Title="Redefinir sua senha" Description="Sua nova senha deve ser diferente das senhas usadas anteriormente." OnSubmit="@OnSubmit">
    <FormHiddenInput @bind-Value="Model!.Token" />
    <FormHiddenInput @bind-Value="Model!.Email" />
    <FormInput @bind-Value="Model!.NewPassword" Label="Nova senha" Placeholder="Digite sua nova senha" Required type="password" />
    <FormInput @bind-Value="Model!.NewPasswordConfirm" Label="Confirmar nova senha" Placeholder="Digite novamente sua nova senha" Required type="password" />
    <FormField Dense>
        <Button Block Color="Color.Primary" Type="ButtonType.Submit">Enviar</Button>
    </FormField>
</PluginForm>
