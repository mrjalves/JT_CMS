@inherits BasePlugin

<PluginForm Model="@Model" Name="@FORM_NAME" Title="Bem-vindo de volta" OnSubmit="@OnSubmit">
    <FormInput @bind-Value="Model!.Username" Label="Usuário" Placeholder="Digite seu usuário" Required />
    <FormInput @bind-Value="Model!.Password" Label="Senha" Placeholder="Digite sua senha" Required type="password" />
    <FormField Dense>
        <Grid ItemsSmall="GridItems.Center" JustifySmall="GridJustify.Between">
            <FormCheckbox @bind-Value="Model!.RememberMe" Cols="6" Dense Text="Lembrar de mim" />
            <GridItem>
                <Button Color="Color.Primary" Href="/auth/forgot-password" Link>Esqueceu a senha?</Button>
            </GridItem>
        </Grid>
        <Spacer />
        <Button Block Color="Color.Primary" Type="ButtonType.Submit">Entrar na sua conta</Button>
        <Spacer />
    </FormField>
    <FormField Dense>
        <Typography>
            Não tem uma conta?
            <Button Color="Color.Primary" Href="/auth/register" Link>Cadastre-se</Button>
        </Typography>
    </FormField>
</PluginForm>
