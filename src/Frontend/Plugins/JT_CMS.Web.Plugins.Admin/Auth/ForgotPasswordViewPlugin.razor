@inherits BasePlugin

@if (IsPosted)
{
    <div class="flex items-center justify-start">
        <div>
            <Typography Weight="TextWeight.Bold">E-mail enviado!</Typography>
            <Typography>Verifique sua caixa de entrada e continue.</Typography>
        </div>
    </div>
}
else
{
    <PluginForm Model="@Model" Name="@FORM_NAME" Title="Esqueci minha senha" Description="Enviaremos por e-mail as instruções para redefinir sua senha." OnSubmit="@OnSubmit">
        <FormInput @bind-Value="Model!.Email" Label="E-mail" Placeholder="Digite seu e-mail" Required />
        <FormField Dense>
            <Button Block Color="Color.Primary" Type="ButtonType.Submit">Enviar</Button>
        </FormField>
    </PluginForm>
}
