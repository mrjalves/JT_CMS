@inherits BasePlugin

<PluginForm Model="@ProfileModel" Name="@PROFILE_FORM_NAME" Title="Perfil" OnSubmit="OnProfileSubmit">
    <FormInput @bind-Value="ProfileModel!.Email" Cols="6" Label="E-mail" Placeholder="Digite o e-mail" Required />
    <FormInput @bind-Value="ProfileModel!.PhoneNumber" Cols="6" Label="Telefone" Placeholder="Digite o telefone" />
    <FormInput @bind-Value="ProfileModel!.FirstName" Cols="6" Label="Nome" Placeholder="Digite o nome" />
    <FormInput @bind-Value="ProfileModel!.LastName" Cols="6" Label="Sobrenome" Placeholder="Digite o sobrenome" />
    <FormActions Submit />
</PluginForm>

<PluginForm Model="@ChangePasswordModel" Name="@CHANGE_PASSWORD_FORM_NAME" Title="Alterar senha" OnSubmit="OnChangePasswordSubmit">
    <FormInput @bind-Value="ChangePasswordModel!.OldPassword" Cols="6" Label="Senha atual" Placeholder="Digite a senha atual" Required type="password" />
    <FormFieldBreak />
    <FormInput @bind-Value="ChangePasswordModel!.NewPassword" Cols="6" Label="Nova senha" Placeholder="Digite a nova senha" Required type="password" />
    <FormInput @bind-Value="ChangePasswordModel!.NewPasswordConfirm" Cols="6" Label="Confirmar nova senha" Placeholder="Digite a nova senha novamente" Required type="password" />
    <FormActions Submit />
</PluginForm>

