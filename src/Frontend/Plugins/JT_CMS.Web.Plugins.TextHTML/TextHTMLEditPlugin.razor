@inherits BaseEditPlugin
@namespace JT_CMS.Web.Plugins.TextHTML

<PluginModalForm Open="Open" Title="Editar Conteúdo Texto/HTML" Model="@Model" OnSubmit="HandleSubmit" OnCancel="OnCancel" Name="@CONTENT_TYPE_NAME">
    <FormTextarea Hint="Use o atributo data-inline-editable em elementos de texto para habilitar a edição em linha!" Placeholder="Digite o conteúdo HTML" Rows="20" @bind-Value="@Model!.Content" Label="Conteúdo" />
</PluginModalForm>