<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>JT_CMS.Web.Plugins.Block</PackageId>
    <Version>0.0.1</Version>
    <Authors>Amir Pournasserian</Authors>
    <Company>JT_CMS</Company>
    <Description>Block plugin.</Description>
    <PackageTags>JT_CMS;cms;block;plugin;core</PackageTags>
    <RepositoryUrl>https://github.com/JT_CMS/JT_CMS</RepositoryUrl>
    <PackageProjectUrl>https://JT_CMS.com</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\JT_CMS.Web.Plugins.Base\JT_CMS.Web.Plugins.Base.csproj" />
    <ProjectReference Include="..\..\..\Providers\MessageBusProviders\JT_CMS.Providers.MessageBusProviders.Abstractions\JT_CMS.Providers.MessageBusProviders.Abstractions.csproj" />
    <ProjectReference Include="..\..\JT_CMS.Web.ApiClients\JT_CMS.Web.ApiClients.csproj" />
    <ProjectReference Include="..\..\JT_CMS.Web.UI.Components\JT_CMS.Web.UI.Components.csproj" />
    <ProjectReference Include="..\JT_CMS.Web.Plugins.RichText\JT_CMS.Web.Plugins.RichText.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\icon.png" Pack="true" PackagePath="icon.png" />
    <None Include="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
