<div class="mt-3 row g-3">
    {{ for project in Items | array.limit 2 }}
        <div class="col-12 col-sm-6">
            <div class="p-3 glass-card border border-border-muted rounded shadow-sm h-100 d-flex flex-column">
                <h4 class="h6 fw-bold text-content-accent mb-1">{{ project.project_title }}</h4>
                <p class="text-content-muted small mb-2 flex-grow-1">{{ project.description }}</p>
                <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-border-accent">
                    <a href="/projects/detail/{{ project.Id }}" class="text-primary small fw-semibold text-decoration-none">Ver Detalhes →</a>
                    {{ if project.project_url }}
                    <a href="{{ project.project_url }}" target="_blank" rel="noopener noreferrer" class="text-content-muted small">GitHub</a>
                    {{ end }}
                </div>
            </div>
        </div>
    {{ end }}
</div>