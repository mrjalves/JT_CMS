            "Contents": [
                {
                    "project_title": "JT_CMS - AI-Powered Modular Headless & Fullstack CMS",
                    "description": "CMS moderno e extensível em .NET 10 e Blazor com recursos impulsionados por IA, suporte a múltiplos bancos de dados, motor Scriban e Site Builder visual.",
                    "start_date": "2025-01-10",
                    "end_date": "2026-10-18",
                    "technologies": "C#, .NET 10, Blazor Server, EF Core, Scriban, Clean Architecture, REST API, Tailwind CSS, SQL Server",
                    "project_url": "https://github.com/mrjalves/JT_CMS",
                    "image": "/files/contents/dashboard.png"
